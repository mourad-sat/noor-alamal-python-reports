# Local: copy this file to .env after running scripts/make_secrets.py
ADMIN_USERNAME=admin
APP_SECRET=replace-with-a-long-random-secret
ADMIN_PASSWORD_HASH=pbkdf2_sha256$390000$SALT_HEX$HASH_HEX
# For Vercel production, connect external Postgres (e.g. Supabase).
# DATABASE_URL=postgresql://postgres.PROJECT:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
